# OpsPilot AI — environment template
# Copy to .env and adjust values. Never commit real secrets.

# Application
APP_ENV=local
APP_VERSION=0.1.0
GIT_SHA=dev

# Data stores
DATABASE_URL=postgresql://ops_pilot:ops_pilot@postgres:5432/ops_pilot
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# LLM provider (mock | openai)
MODEL_PROVIDER=mock
OPENAI_API_KEY=sk-example-not-a-real-key
OPENAI_MODEL=gpt-4o-mini

# Agent limits
MAX_AGENT_ITERATIONS=12
MAX_TOKENS_PER_INCIDENT=120000

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth / JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Seed users (development only — never use in production)
SEED_VIEWER_EMAIL=viewer@ops-pilot.local
SEED_VIEWER_PASSWORD=viewer-dev-password
SEED_VIEWER_DISPLAY_NAME=Viewer Dev
SEED_OPERATOR_EMAIL=operator@ops-pilot.local
SEED_OPERATOR_PASSWORD=operator-dev-password
SEED_OPERATOR_DISPLAY_NAME=Operator Dev
SEED_APPROVER_EMAIL=approver@ops-pilot.local
SEED_APPROVER_PASSWORD=approver-dev-password
SEED_APPROVER_DISPLAY_NAME=Approver Dev
SEED_ADMIN_EMAIL=admin@ops-pilot.local
SEED_ADMIN_PASSWORD=admin-dev-password
SEED_ADMIN_DISPLAY_NAME=Admin Dev
