# OpsPilot AI — environment template
# Copy to .env and adjust values. Never commit real secrets.

# Application
APP_ENV=local
APP_VERSION=0.1.0
GIT_SHA=dev

# Data stores
DATABASE_URL=postgresql://ops_pilot:ops_pilot@postgres:5432/ops_pilot
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# LLM provider (mock | openai)
MODEL_PROVIDER=mock
OPENAI_API_KEY=sk-example-not-a-real-key
OPENAI_MODEL=gpt-4o-mini

# Agent limits
MAX_AGENT_ITERATIONS=12
MAX_TOKENS_PER_INCIDENT=120000

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
