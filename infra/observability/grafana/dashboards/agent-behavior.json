{
  "uid": "opspilot-agent",
  "title": "OpsPilot — Agent Behavior",
  "tags": ["opspilot", "agent"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Node Duration P95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(opspilot_agent_node_duration_seconds_bucket[5m])) by (le, node))", "legendFormat": "{{node}}"}
      ]
    },
    {
      "id": 2,
      "title": "Tool Calls",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(rate(opspilot_agent_tool_calls_total[5m])) by (tool, status)", "legendFormat": "{{tool}} {{status}}"}
      ]
    },
    {
      "id": 3,
      "title": "Tokens by Stage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum(rate(opspilot_agent_tokens_total[5m])) by (stage, direction)", "legendFormat": "{{stage}} {{direction}}"}
      ]
    },
    {
      "id": 4,
      "title": "Approvals",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum(rate(opspilot_agent_approvals_total[5m])) by (outcome)", "legendFormat": "{{outcome}}"}
      ]
    }
  ]
}
