{
  "uid": "opspilot-system",
  "title": "OpsPilot — System Health",
  "tags": ["opspilot", "system"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(opspilot_http_requests_total[5m])) by (endpoint)", "legendFormat": "{{endpoint}}"}
      ]
    },
    {
      "id": 2,
      "title": "HTTP Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(rate(opspilot_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(opspilot_http_requests_total[5m]))", "legendFormat": "error_rate"}
      ]
    },
    {
      "id": 3,
      "title": "P95 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(opspilot_http_request_duration_seconds_bucket[5m])) by (le, endpoint))", "legendFormat": "{{endpoint}}"}
      ]
    }
  ]
}
